# LLM / Grader
DEEPGRAM_API_KEY=
GOOGLE_API_KEY=
CARTESIA_API_KEY=
# Fallback Cartesia keys — used automatically if the primary returns HTTP 402.
# Add up to two more keys (leave blank or remove the lines if unused).
CARTESIA_API_KEY_2=
CARTESIA_API_KEY_3=
# Cartesia TTS model (examiner voice). Options: sonic-3.6 (default), sonic-2,
# sonic-turbo (lower latency). Change + restart to switch.
CARTESIA_TTS_MODEL=sonic-turbo

# Optional: Connect via Daily WebRTC locally
#DAILY_API_KEY=

# TTS — ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Groq (optional — enables Groq LLM toggle in UI)
GROQ_API_KEY=

# Exam config
# Conversation LLM. gemini-3.5-flash is accurate but slow (~4.4s TTFB) and makes
# the examiner's voice break/pause mid-turn. gemini-2.5-flash is much faster and
# closes those gaps. Revert to gemini-3.5-flash here if exam-flow adherence drops.
GEMINI_CONVERSATION_MODEL=gemini-2.5-flash
EXAM_TOPIC=gene editing
EXAM_DURATION_MINUTES=6
GEMINI_GRADER_MODEL=gemini-3.5-flash
GEMINI_VIDEO_GRADER_MODEL=gemini-3.5-flash
# LiveKit + Gemini Live realtime model (video mode). gemini-3.8-live is the GA
# Live API model (launched 2026-09-15) and the default here. NOTE: the older
# gemini-3.1-flash-live-preview / *-native-audio-preview-* models RETIRE on
# 2026-11-17 — do not pin them. A reasoning variant (gemini-3.8-live-extended-
# thinking) exists if deeper background reasoning is ever needed.
GEMINI_LIVE_MODEL=gemini-3.8-live
# Video examiner voice (female). Gemini Live female: Aoede, Kore, Leda, Zephyr.
GEMINI_LIVE_VOICE=Aoede

# LiveKit (used by the video-mode session path)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Gemini Live realtime API key — used by the LiveKit support-agent for the
# video-mode conversational stream. Distinct from GOOGLE_API_KEY because the
# realtime endpoint is keyed separately.
GEMINI_API_KEY=
ASSEMBLYAI_API_KEY=
XAI_API_KEY=
CEREBRAS_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
